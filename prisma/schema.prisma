generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model School {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  classes   StudentClass[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AcademicYear {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  startYear   Int
  endYear     Int
  isActive    Boolean        @default(false)
  classes     StudentClass[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive])
}

model Grade {
  id        Int            @id @default(autoincrement())
  code      String         @unique
  title     String
  classes   StudentClass[]
  chapters  Chapter[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model StudentClass {
  id           Int             @id @default(autoincrement())
  name         String
  gradeId      Int
  grade        Grade           @relation(fields: [gradeId], references: [id])
  schoolId     Int
  school       School          @relation(fields: [schoolId], references: [id])
  academicYearId Int
  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id])
  students     User[]
  assignments  ExamAssignment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([name, schoolId, academicYearId])
}

model Chapter {
  id           Int       @id @default(autoincrement())
  gradeId       Int
  grade         Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  code          String
  title         String
  displayOrder  Int       @default(0)
  lessons       Lesson[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([gradeId, code])
  @@index([gradeId, displayOrder])
}

model Lesson {
  id            Int       @id @default(autoincrement())
  chapterId      Int
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number         Int?
  title          String
  theoryContent  String    @default("")
  displayOrder   Int       @default(0)
  exam           Exam?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([chapterId, title])
  @@index([chapterId, displayOrder])
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  fullName  String
  classId    Int?
  studentClass StudentClass? @relation(fields: [classId], references: [id])
  role      Role      @default(STUDENT)
  deletedAt DateTime?
  attempts  Attempt[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Exam {
  id            Int             @id @default(autoincrement())
  lessonId       Int             @unique
  lesson         Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  exerciseTitle String          @default("Bài tập")
  isPublic      Boolean         @default(true)
  deletedAt     DateTime?
  assignments   ExamAssignment[]
  nodes         MindNode[]
  attempts      Attempt[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([deletedAt])
}

model ExamAssignment {
  id        Int          @id @default(autoincrement())
  examId     Int
  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId     Int
  studentClass StudentClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([examId, classId])
}

model MindNode {
  id            Int          @id @default(autoincrement())
  examId        Int
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  parentId      Int?
  label         String
  question      String
  questionImage String?
  options       Json?
  optionImages  Json?
  correctAnswer String
  answerImage   String?
  hint          String       @default("")
  hintImage     String?
  points        Int          @default(1)
  order         Int          @default(0)
  nodeAnswers   NodeAnswer[]
}

model Attempt {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  examId      Int
  exam        Exam         @relation(fields: [examId], references: [id])
  score       Int          @default(0)
  isComplete  Boolean      @default(false)
  nodeAnswers NodeAnswer[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
}

model NodeAnswer {
  id         Int      @id @default(autoincrement())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  Int
  node       MindNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId     Int
  answer     String
  isCorrect  Boolean
  answeredAt DateTime @default(now())

  @@unique([attemptId, nodeId])
}
